# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/ca_office_workflow?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=your_secure_jwt_secret_key_here

# Local Development Port (Default: 3000)
PORT=3000

# Optional AI Assistant Keys (for Generative Assistant Fallback in Chat)
GEMINI_API_KEY=
OPENAI_API_KEY=
